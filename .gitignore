#
# Build ignores
#
#.*
*.o
*.o.*
*.obj
*.exe
*.a
*.so
*.so.*
*.1.gz

#
# Never ignore these
#
!.gitignore

#
# Normal output and testing dirs
#
/spitemail*.exe
/spitemail-*-*/
/spitemail-*-*.zip
/*.pkg.tar.*
/ljc_vercheck*
output.log

#
# Backups / patches
#
*~
*.orig
*.rej
/*.patch

#
# debugging and editor stuff
#
core
.gdb_history
.gdbinit
.*.swp
*.gcda
*.gcno
*.gcov
